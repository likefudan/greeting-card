{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-greeting-card",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "qr-greeting-card", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "TIME_ZONE": "America/Los_Angeles" }
  // After llmat.dev is active in this Cloudflare account, add:
  // ,"routes": [{ "pattern": "card.llmat.dev", "custom_domain": true }]
}
